# Cloudflare Pages & Static Hosting Routing Configuration
# 1. Clean URL Rewrites (200 = Internal URL Rewrite)
/about /about.html 200
/payment /payment.html 200
/legal /legal.html 200
/admin /admin/index.html 200
/admin/login /admin/login.html 200
/admin/* /admin/index.html 200

# 2. Canonical Clean URL 301 Redirects
/index.html / 301
/about.html /about 301
/payment.html /payment 301
/legal.html /legal 301
/admin/index.html /admin 301
/admin/login.html /admin/login 301

# 3. Deprecated & Legacy Paths Redirects
/login / 301
/login.html / 301
/seller / 301
/seller/* / 301

# 4. Security Protection (Prevent Public Access to Config / Env / Source files)
/.env* / 302
/.git* / 302
/database.rules.json / 302
/package.json / 302
/package-lock.json / 302
/dev-server.mjs / 302
